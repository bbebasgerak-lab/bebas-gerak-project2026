# Salin jadi .env.local, lalu isi. Jangan pernah upload .env.local ke GitHub.

# CLERK (login) — diisi otomatis oleh `clerk init`, atau salin dari Clerk -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/masuk
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/daftar
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/mulai
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/mulai

# SUPABASE (database) — Project Settings -> API. Service role key RAHASIA, hanya untuk server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# MIDTRANS (pembayaran) — Settings -> Access Keys. Mulai dengan Sandbox (false).
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# WHATSAPP bantuan, format 628xxxxxxxxxx
NEXT_PUBLIC_WHATSAPP_NUMBER=

# META PIXEL (opsional, untuk iklan)
NEXT_PUBLIC_META_PIXEL_ID=
